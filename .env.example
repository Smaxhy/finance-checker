# ---------------------------------------------------------------------------
# Required: Supabase (auth + Postgres). Local: `npx supabase start` prints these.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for token storage, background sync, account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# 32 random bytes (base64) used to AES-256-GCM encrypt OAuth tokens / bank sessions at rest.
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Protects /api/cron/* (daily sync + notifications). Generate with: openssl rand -hex 24
CRON_SECRET=

# ---------------------------------------------------------------------------
# Optional: Gmail + Google Calendar (read-only OAuth)
# Google Cloud Console > APIs & Services: enable Gmail API + Google Calendar API,
# create an OAuth client (Web application) with redirect URI:
#   <NEXT_PUBLIC_APP_URL>/api/integrations/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Optional: Belgian / EU bank accounts via Enable Banking (PSD2 AIS, read-only)
# Register an application at enablebanking.com (sandbox or production), set its
# redirect URL to <NEXT_PUBLIC_APP_URL>/api/integrations/enablebanking/callback
# and paste the application id + the private key (.pem) it gives you.
# ---------------------------------------------------------------------------
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_PRIVATE_KEY=
ENABLE_BANKING_COUNTRY=BE
# ENABLE_BANKING_API_ORIGIN=https://api.enablebanking.com

# ---------------------------------------------------------------------------
# Optional: AI assistant + AI email extraction (Anthropic Claude API)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_EXTRACTION_MODEL=claude-opus-5-5
# How much reasoning Claude spends per answer: low | medium (default) | high
# AI_EFFORT=medium
